{
    "firestore":  {
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "hosting":  {
                    "site":  "tenx-markets-admin",
                    "public":  "admin-panel/dist",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ],
                    "headers":  [
                                    {
                                        "source":  "**/*.@(js|css)",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "public,max-age=300"
                                                        }
                                                    ]
                                    },
                                    {
                                        "source":  "**",
                                        "headers":  [
                                                        {
                                                            "key":  "X-Content-Type-Options",
                                                            "value":  "nosniff"
                                                        },
                                                        {
                                                            "key":  "Referrer-Policy",
                                                            "value":  "strict-origin-when-cross-origin"
                                                        },
                                                        {
                                                            "key":  "X-Frame-Options",
                                                            "value":  "DENY"
                                                        }
                                                    ]
                                    }
                                ]
                },
    "remoteconfig":  {
                         "template":  "remote_config.json"
                     }
}
